# KoboToolbox API Configuration
# Do NOT prefix with VITE_ — these are server-side only (Netlify Functions)
KOBO_BASE_URL=https://kf.kobotoolbox.org
KOBO_API_TOKEN=
KOBO_FACILITY_ASSET_UID=
KOBO_CAREGIVER_ASSET_UID=

# Refresh interval in minutes
DATA_REFRESH_INTERVAL_MINUTES=5

# Data mode: development | testing | production
# This is the only VITE_ variable — it controls the client-side data source.
# It does NOT expose any credentials to the browser.
VITE_DATA_MODE=development

# Fieldwork start date (ISO format) — submissions before this may be test data
FIELDWORK_START_DATE=
